eventGraph = target {domain: graph, asset: "/Game/Doors/BP_Door.BP_Door", blueprintId: "11111111-1111-1111-1111-111111111111", id: "22222222-2222-2222-2222-222222222222"}
patch eventGraph dry run

delay = node {palette: "Delay", Duration: 1.0}
add delay
connect @aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa/aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaab -> delay.execute
set @cccccccc-cccc-cccc-cccc-cccccccccccc.NodeComment = "Print after delay"
move @cccccccc-cccc-cccc-cccc-cccccccccccc to (640, 0)

---

result exact_target
target eventGraph = target {domain: graph, asset: "/Game/Doors/BP_Door.BP_Door", blueprintId: "11111111-1111-1111-1111-111111111111", id: "22222222-2222-2222-2222-222222222222"}
related blueprintTarget = target {domain: blueprint, asset: "/Game/Doors/BP_Door.BP_Door", id: "11111111-1111-1111-1111-111111111111"}
handoff compile to blueprintTarget
objects
delay = node {type: "/Script/BlueprintGraph.K2Node_CallFunction", FunctionReference: "Delay", Duration: 1.0}
delay.execute = pin {direction: in}
print = node {id: "cccccccc-cccc-cccc-cccc-cccccccccccc", type: "/Script/BlueprintGraph.K2Node_CallFunction", NodeComment: "Print after delay"}
