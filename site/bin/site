#!/usr/bin/env bash

set -euo pipefail

site_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
command_name="${1:-}"

use_ruby_33() {
  local current_version=""
  if command -v ruby >/dev/null 2>&1; then
    current_version="$(ruby -e 'print RUBY_VERSION' 2>/dev/null || true)"
  fi

  if [[ "$current_version" == 3.3.* ]]; then
    return
  fi

  if command -v brew >/dev/null 2>&1; then
    local brew_ruby
    brew_ruby="$(brew --prefix ruby@3.3 2>/dev/null || true)"
    if [[ -x "$brew_ruby/bin/ruby" ]]; then
      export PATH="$brew_ruby/bin:$PATH"
      current_version="$(ruby -e 'print RUBY_VERSION')"
    fi
  fi

  if [[ "$current_version" != 3.3.* ]]; then
    cat >&2 <<'EOF'
Loomle site development requires Ruby 3.3.

On macOS:
  brew install ruby@3.3

Then rerun:
  npm run site:setup
EOF
    exit 1
  fi
}

require_bundle() {
  if ! bundle check >/dev/null 2>&1; then
    cat >&2 <<'EOF'
Site dependencies are not installed.

Run:
  npm run site:setup
EOF
    exit 1
  fi
}

use_ruby_33
cd "$site_dir"

case "$command_name" in
  setup)
    bundle config set --local path .bundle/gems
    bundle install
    ;;
  build)
    require_bundle
    bundle exec jekyll build --destination _site
    ;;
  serve)
    require_bundle
    bundle exec jekyll serve \
      --livereload \
      --host 127.0.0.1 \
      --port "${LOOMLE_SITE_PORT:-4000}"
    ;;
  check)
    require_bundle
    bundle exec jekyll build --destination _site
    latest_release_url="https://github.com/loomle/loomle/releases/latest"
    latest_archive_url="$latest_release_url/download/loomle-bridge.zip"
    latest_sha_url="$latest_archive_url.sha256"
    legacy_manifest_version="$(ruby -rjson -e 'print JSON.parse(File.read("releases.json")).dig("channels", "stable", "version")')"
    legacy_release_url="$(ruby -rjson -e 'print JSON.parse(File.read("releases.json")).dig("channels", "stable", "releaseUrl")')"
    legacy_mac_archive_url="$(ruby -rjson -e 'print JSON.parse(File.read("releases.json")).dig("channels", "stable", "targets", "darwin-arm64", "assetUrl")')"
    legacy_windows_archive_url="$(ruby -rjson -e 'print JSON.parse(File.read("releases.json")).dig("channels", "stable", "targets", "win32-x64", "assetUrl")')"
    legacy_mac_sha="$(ruby -rjson -e 'print JSON.parse(File.read("releases.json")).dig("channels", "stable", "targets", "darwin-arm64", "sha256")')"
    legacy_windows_sha="$(ruby -rjson -e 'print JSON.parse(File.read("releases.json")).dig("channels", "stable", "targets", "win32-x64", "sha256")')"
    legacy_prerelease="$(ruby -rjson -e 'print JSON.parse(File.read("releases.json")).dig("channels", "prerelease").nil? ? "null" : "non-null"')"
    test -s _site/index.html
    test -s _site/assets/css/loomle.css
    test -s _site/assets/images/oasium-cover.webp
    test ! -e _site/bin/site
    grep -q '<title>Loomle AI - Weave New Worlds with AI Agents</title>' _site/index.html
    grep -q '<title>Quickstart | Loomle AI</title>' _site/quickstart.html
    grep -q '<title>Agent Skill | Loomle AI</title>' _site/calls/agent-skill.html
    grep -q '<title>Format a Blueprint Graph | Loomle AI</title>' _site/workflows/blueprint-format-graph.html
    grep -Fq "The latest stable Loomle release is available" _site/install.html
    grep -Fq "$latest_release_url" _site/install.html
    grep -Fq "$latest_archive_url" _site/install.html
    grep -Fq "$latest_sha_url" _site/install.html
    test -s releases.json
    test -s _site/releases.json
    test "$legacy_manifest_version" = "0.7.7"
    test "$legacy_release_url" = "$latest_release_url"
    test "$legacy_mac_archive_url" = "$latest_archive_url"
    test "$legacy_windows_archive_url" = "$latest_archive_url"
    test "$legacy_mac_sha" = "$legacy_windows_sha"
    [[ "$legacy_mac_sha" =~ ^[0-9a-f]{64}$ ]]
    test "$legacy_prerelease" = "null"
    ! grep -Eq 'releases/(tag|download)/v[0-9]' install.md llms.txt
    ! grep -Eq 'loomle-bridge-[0-9]+\.[0-9]+\.[0-9]+\.zip' install.md llms.txt
    grep -q 'Three core calls. Every supported Unreal object.' _site/index.html
    grep -q '<strong>sal_schema</strong>' _site/index.html
    grep -q '<strong>sal_query</strong>' _site/index.html
    grep -q '<strong>sal_patch</strong>' _site/index.html
    grep -q '03 / RESIDENT AGENT SKILLS' _site/index.html
    grep -q 'Domain expertise, loaded on demand.' _site/index.html
    grep -q 'class="loom-skill-proofs"' _site/index.html
    grep -q 'assets/images/blueprint-layout-before.png' _site/index.html
    grep -q 'assets/images/blueprint-layout-after.png' _site/index.html
    grep -q 'seven public Loomle MCP tools' _site/calls/index.html
    grep -q 'Seven public MCP tools:' _site/llms.txt
    grep -Fq 'editor({})' _site/calls/editor.html
    grep -q 'format-unreal-blueprints' _site/llms.txt
    ! grep -Eq 'loomle-fab-plugin-(darwin-arm64|win32-x64)' install.md llms.txt
    grep -q 'class="loom-sal"' _site/index.html
    grep -q 'class="language-sal"' _site/index.html
    grep -q '<span class="kd">patch</span>' _site/index.html
    grep -q '<span class="nn">@source-node-guid</span>' _site/index.html
    grep -q '<span class="nn">source-pin-guid</span>' _site/index.html
    grep -q '<span class="na">then</span>' _site/index.html
    grep -q '<span class="c1"># excerpt:' _site/index.html
    grep -q '<span class="kd">query</span>' _site/concepts/sal.html
    grep -q 'language-sal highlighter-rouge' _site/workflows/blueprint-add-node.html
    grep -q 'SAL / PATCH TEXT' _site/index.html
    grep -q 'ADD / CONNECT' _site/index.html
    grep -q '01 / HUMAN–AGENT–COMPUTER' _site/index.html
    grep -q '02 / UNREAL ENGINE MCP' _site/index.html
    grep -q 'SAL — Structured Agent Language' _site/index.html
    grep -q 'class="loom-heading-title"' _site/index.html
    grep -q 'class="loom-heading-description"' _site/index.html
    ! grep -q '<strong>status</strong>' _site/index.html
    ! grep -q '<strong>project</strong>' _site/index.html
    ! grep -q '<strong>agent_skill</strong>' _site/index.html
    grep -q 'Compose ordered Unreal edits' _site/index.html
    grep -q '04 / PLAYERS–AGENTS–WORLDS' _site/index.html
    grep -q '05 / START CREATING' _site/index.html
    grep -q 'assets/images/oasium-cover.webp' _site/index.html
    grep -q 'https://oasium.io/' _site/index.html
    grep -q 'class="loom-mobile-menu"' _site/index.html
    grep -q 'class="loom-mobile-menu-nav"' _site/index.html
    echo "Site check passed."
    ;;
  *)
    cat >&2 <<'EOF'
Usage: site/bin/site <setup|build|serve|check>
EOF
    exit 2
    ;;
esac
